# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MAMO Pay
MAMOPAY_API_KEY=sk-your-mamopay-api-key
MAMOPAY_WEBHOOK_SECRET=your-webhook-secret
# Base API MAMO Pay (default produzione). Per test: https://sandbox.dev.business.mamopay.com/manage_api/v1
MAMOPAY_API_BASE=https://business.mamopay.com/manage_api/v1

# Google Calendar (prenotazione call: disponibilita + creazione evento con Meet)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary

# Prenotazione call (valori con default sensati, opzionali)
BOOKING_NOTIFY_EMAIL=info@pellegrinobozzella.com
BOOKING_TIMEZONE=Asia/Dubai
BOOKING_UTC_OFFSET=+04:00
BOOKING_WORK_DAYS=1,2,3,4,5
BOOKING_WORK_START=10
BOOKING_WORK_END=18
BOOKING_SLOT_STEP_MIN=30
BOOKING_MIN_LEAD_HOURS=12
BOOKING_FREE_DURATION_MIN=20
BOOKING_PAID_DURATION_MIN=45
BOOKING_PAID_PRICE_AED=300

# Site
NEXT_PUBLIC_SITE_URL=https://societa-dubai.it
